[Unit]
Description=Runbow007 failure notification for %i
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/runbow007
EnvironmentFile=/etc/runbow007/runtime.env
ExecStart=/opt/runbow007/scripts/notify-failure-alinux3.sh %i
TimeoutStartSec=3min
